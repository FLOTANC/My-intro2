DATABASE_URL=postgres://user:pass@host/db
SESSION_SECRET=long-random-string-here
# Local Postgres + Docker only: URL of a local Neon HTTP proxy (e.g. timowilhelm/local-neon-http-proxy)
# in front of plain Postgres. Leave unset in production so DATABASE_URL talks to Neon directly.
NEON_LOCAL_PROXY=http://localhost:4444/sql
